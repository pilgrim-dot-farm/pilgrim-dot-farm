[Unit]
Description=NInfer serve - Qwen3.8-27B NVFP4 (model id qwen38, port 8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=justin
WorkingDirectory=/home/justin/local_llm/ninfer
ExecStart=/usr/bin/bash ./run.sh
Restart=on-failure
